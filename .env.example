# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored. Never commit real keys.

# ── Auth0 (setup steps: server/src/auth/README.md) ──────────────────
# Leave blank to run without login (everything saves as "guest").
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=

# ── Database ────────────────────────────────────────────────────────
# Tiger Data PostgreSQL connection string (Tiger console → Connect)
DATABASE_URL=

# ── Gemini (Google AI Studio → Get API key) ─────────────────────────
GEMINI_API_KEY=

# ── Server (defaults are fine locally) ──────────────────────────────
# PORT=3001
# CLIENT_ORIGIN=http://localhost:5173
