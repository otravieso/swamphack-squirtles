# Copy this file to `.env` (same folder) and fill in your own values.
# `.env` is gitignored. Never commit real keys.

# ── Gemini API (Google AI Studio → "Get API key") ─────────────────────
# Leave blank to run with built-in sample questions (no AI calls).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── Server ─────────────────────────────────────────────────────────────
PORT=3001
# Where the browser game is served from (used for CORS in production)
CLIENT_ORIGIN=http://localhost:5173

# ── Auth0 (manage.auth0.com → Applications) ────────────────────────────
# Leave blank to play as a guest (no login).
# Single Page Application settings (read by the browser game):
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
# API identifier (Auth0 → APIs → Create API), shared by client + server:
VITE_AUTH0_AUDIENCE=
# Server-side copies used to verify login tokens:
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
